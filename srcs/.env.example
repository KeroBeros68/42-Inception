# Domain name that must resolve to the host's local IP (format: login.42.fr)
DOMAIN_NAME=

# MARIADB
# Hostname of the MariaDB service on the Docker network
MARIADB_HOST=
# Port MariaDB listens on
MARIADB_PORT=
# Name of the WordPress database created on first boot
MARIADB_DATABASE=
# Non-root MariaDB user granted access to MARIADB_DATABASE
MARIADB_USER=
# Host path (must live under /home/<login>/data) backing the mariadb_data named volume
MARIADB_DATA_PATH=

# NGINX
# Port nginx listens on inside the container (TLS)
NGINX_PORT=
# Host port published to reach nginx from outside
NGINX_HOST_PORT=

# WORDPRESS
# Host path (must live under /home/<login>/data) backing the wordpress_data named volume
WORDPRESS_DATA_PATH=
# Port php-fpm listens on for nginx's FastCGI requests
WORDPRESS_PORT=
# WordPress administrator username (must not contain admin/Admin/administrator/Administrator)
WP_ADMIN_USER=
# Second WordPress user (non-administrator)
WP_USER=

# REDIS
# Hostname of the Redis service on the Docker network
REDIS_HOST=
# Port Redis listens on
REDIS_PORT=
# Host path backing the redis_data named volume
REDIS_DATA_PATH=

# PURE-FTPD
# FTP control port
FTP_PORT=
# FTP virtual user allowed to log in, chrooted to the WordPress volume
FTP_USER=
# Lower bound of the passive-mode data port range
FTP_PASSIVE_MIN_PORT=
# Upper bound of the passive-mode data port range
FTP_PASSIVE_MAX_PORT=

# ADMINER
# Port Adminer's PHP-FPM listens on for nginx's FastCGI requests
ADMINER_PORT=
